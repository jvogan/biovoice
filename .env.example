OPENAI_API_KEY=
OPENAI_USAGE_API_KEY=
OPENAI_USAGE_PROJECT_ID=
PORT=3000
HOST=127.0.0.1
# Enabling remote clients requires a separate access token for browser/session setup.
ALLOW_REMOTE_CLIENTS=false
PUBLIC_BASE_URL=http://localhost:3000
# Optional. If omitted, BioVoice generates a startup token and prints the access URL.
REMOTE_ACCESS_TOKEN=
VITE_SERVER_BASE_URL=http://localhost:3000
# Additional browser origins allowed to make cross-origin requests after remote access is authorized.
LOCAL_BROWSER_ORIGINS=
REALTIME_MODEL=gpt-realtime-1.5
REALTIME_VOICE=marin
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
REALTIME_TRANSCRIPTION_PROMPT_HINT=
REALTIME_OUTPUT_SPEED=1
REALTIME_MAX_OUTPUT_TOKENS=1536
REALTIME_IDLE_WARNING_SECONDS=30
REALTIME_PTT_IDLE_DISCONNECT_SECONDS=900
REALTIME_OPEN_MIC_IDLE_DISCONNECT_SECONDS=180
# Per-session local guardrails. BioVoice warns before these app-level caps and
# disconnects a session that crosses them so one live session cannot drift into
# runaway cost. These are separate from OpenAI account rate/monthly limits.
REALTIME_MAX_SESSION_MINUTES=25
REALTIME_MAX_RESPONSES_PER_SESSION=18
REALTIME_MAX_TRANSCRIPTIONS_PER_SESSION=36
REALTIME_MAX_BILLABLE_TOKENS_PER_SESSION=120000
REALTIME_MAX_ACTIVE_SESSIONS=2
REALTIME_USAGE_WARNING_RATIO=0.8
REALTIME_TRACING=true
REALTIME_DEBUG_RAW_EVENTS=false
ENABLE_EXPERT_RAW_COMMANDS=false
# When true, session event logs may be written under .runtime/.
PERSIST_SESSION_EVENT_LOGS=false
REALTIME_ENABLE_TRUNCATION=true
REALTIME_RETENTION_RATIO=0.8
REALTIME_POST_INSTRUCTIONS_TOKENS=12000
DEFAULT_TARGET=pymol
# Home-machine paths only: keep any absolute local paths in your private .env,
# not in tracked files. The launcher assumes standard macOS installs under
# /Applications unless you explicitly pin a running local session.
PYMOL_RPC_BASE_URL=http://127.0.0.1
# Optional: pin BioVoice to one specific local PyMOL RPC session on this machine.
PYMOL_RPC_URL=
PYMOL_RPC_START_PORT=9123
PYMOL_TIMEOUT_MS=8000
PYMOL_RENDER_TIMEOUT_MS=120000
# ChimeraX uses its local REST port rather than a tracked application path.
CHIMERAX_REST_PORT=60958
CHIMERAX_TIMEOUT_MS=30000
ENABLE_AUTOLAUNCH=true
RUNTIME_EXPORT_RETENTION_HOURS=48
RUNTIME_EXPORT_KEEP_LATEST=40
# Captures, transcripts, and runtime logs are retained locally until cleanup.
RUNTIME_SESSION_RETENTION_HOURS=24
RUNTIME_AGENT_LOG_RETENTION_HOURS=72
RUNTIME_AGENT_LOG_KEEP_LATEST=12
RUNTIME_TEMP_RETENTION_HOURS=24
RUNTIME_TEMP_KEEP_LATEST=20
# Optional comma-separated absolute paths for private structure inputs.
# By default, BioVoice only reads structures from examples/data/local, .runtime,
# and output. Keep any wider roots in local .env, never in tracked files.
STRUCTURE_ALLOWED_PATHS=
EXPORT_ALLOWED_PATHS=
